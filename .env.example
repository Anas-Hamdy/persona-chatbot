# Copy this file to .env and fill in the values you need, or set these as
# real environment variables in your hosting platform's dashboard/CLI.
# Never commit a real .env file.

# Required in production (FLASK_ENV=production refuses to start without it).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "production" enables secure-cookie mode and disables the Flask debugger.
# Leave unset (or "development") for local testing.
FLASK_ENV=development

# Optional - if set, replies are generated by a real LLM instead of the
# offline template fallback. Set at most one; OpenAI is tried first.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
PORT=5000
PROFILE_STORAGE_DIR=profiles
LOG_LEVEL=INFO
